# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE_CHANNEL_ACCESS_TOKEN: Channel Access Token (long-lived) from LINE Developers Console -> Messaging API.
# Users configure this in the Secrets panel in the AI Studio UI or server environment.
LINE_CHANNEL_ACCESS_TOKEN=""

# LINE_CHANNEL_SECRET: Channel Secret from LINE Developers Console -> Basic settings.
LINE_CHANNEL_SECRET=""

# LINE_GROUP_ID: Default target LINE Group ID (e.g. C0123456789abcdef0123456789abcde) for duty roster broadcasts.
LINE_GROUP_ID=""

# LINE_USER_ID: Default test LINE User ID (e.g. Ua1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6).
LINE_USER_ID=""
